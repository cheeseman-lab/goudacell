__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.env
.venv/
env/
venv/

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific - ignore images but keep data folder
data/*
!data/.gitkeep
*.tif
*.tiff
*.nd2
*.dv
*_mask.tif

# Tests are kept local-only (not tracked)
tests/

# SLURM outputs
*.out
*.err
slurm-*.out

# Logs
*.log

# Generated configs
*_config.yaml

# Generated artifact folders — keep the structure, ignore the contents
configs/*
!configs/.gitkeep
masks/*
!masks/.gitkeep
features/*
!features/.gitkeep
out/*
!out/.gitkeep
!out/logs/
out/logs/*
!out/logs/.gitkeep
